# Copy to .env (git-ignored) and fill in. Values: Supabase dashboard → Project Settings → API.

# --- Frontend (safe to expose; protected by Row-Level Security) ---
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# --- Server-side scripts only (scripts/generate-qr.mjs) ---
# The service role key bypasses RLS. Never prefix it with VITE_, never commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Public domain of the deployed PWA. It is printed inside every QR: fix it before printing.
QR_BASE_URL=https://your-domain.example
